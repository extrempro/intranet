# Kopieren nach .env und Werte setzen. .env niemals committen.

# Öffentliche Adresse, unter der das Intranet über den Reverse Proxy erreichbar ist
ORIGIN=https://intranet.example.de

# Port auf dem Host, auf den der Reverse Proxy zeigt
APP_PORT=3000

# Datenbank
POSTGRES_USER=intranet
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
POSTGRES_DB=intranet

# Passwort der eingeschränkten Rolle intranet_app, mit der die Anwendung Inhalte
# liest (Row-Level Security). Die Rolle legt eine Migration an, das Passwort setzt
# die Anwendung beim Start. Muss sich vom POSTGRES_PASSWORD unterscheiden.
APP_DATABASE_PASSWORD=bitte-ein-anderes-langes-zufaelliges-passwort

# Für lokale Entwicklung ohne Docker
DATABASE_URL=postgres://intranet:bitte-ein-langes-zufaelliges-passwort@localhost:5432/intranet

# Maximale Größe einer Anfrage. Dateien werden einzeln hochgeladen (je höchstens 20 MB).
BODY_SIZE_LIMIT=21M

# Ablage für verschlüsselte Dateien (im Container /data/files, als Volume).
# Zusammen mit der Datenbank sichern: Ohne Datenbank (Schlüssel) sind die Dateien wertlos,
# ohne ENCRYPTION_KEY ebenso.
# FILES_DIR=./data/files

# Migrationen beim Start einspielen (Standard). Nur zur Fehlersuche abschalten.
# MIGRATE_ON_START=false

# --- Anmeldung mit Microsoft Entra ID ---
# App-Registrierung in Entra:
#   Umleitungs-URI (Web): ${ORIGIN}/anmelden/entra/callback
#   Delegierte Graph-Berechtigungen: openid, profile, email, User.Read,
#   GroupMember.Read.All (Administratorzustimmung erteilen)
# Tenant-ID, Client-ID und Zugangsgruppe werden später in der Verwaltung gepflegt;
# bis dahin gelten diese Werte. Das Secret bleibt immer hier (bzw. als Docker-Secret).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Object-ID der Gruppe, deren Mitglieder sich anmelden dürfen
ENTRA_ACCESS_GROUP_ID=
# Object-ID der Gruppe, deren Mitglieder System-Admin werden (Erstbefüllung)
ENTRA_ADMIN_GROUP_ID=

# --- E-Mail (Einladungen, später Benachrichtigungen) ---
# Absenderpostfach (UPN oder Adresse); später in der Verwaltung pflegbar
MAIL_SENDER=
# Optional: Antwortadresse
MAIL_REPLY_TO=

# --- Verschlüsselung ---
# 32 Byte, base64. Erzeugen: openssl rand -base64 32
# Schützt u. a. die TOTP-Schlüssel. Nicht verlieren und nicht ändern, sonst
# müssen alle lokalen Konten den zweiten Faktor neu einrichten.
ENCRYPTION_KEY=

# --- Erstbefüllung ---
# Gibt es noch keinen Mandanten, legt die Anwendung beim Start den Hauptmandanten
# mit diesen Domains an. Danach wird hier nichts mehr gelesen; Pflege unter
# Verwaltung → Mandanten. Domains durch Komma trennen. Farben optional.
INITIAL_TENANT_NAME=
INITIAL_TENANT_SHORT=
INITIAL_TENANT_DOMAINS=
# INITIAL_TENANT_ACCENT=#0F6E56
# INITIAL_TENANT_ACCENT_DARK=#5DCAA5

# Kontaktadresse für Push-Dienste (VAPID „subject“). Die Schlüssel erzeugt die
# Anwendung beim ersten Start selbst und speichert sie verschlüsselt (ENCRYPTION_KEY).
# PUSH_CONTACT=mailto:it@example.org
