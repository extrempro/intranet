# Kopieren nach .env und Werte setzen. .env niemals committen.

# Öffentliche Adresse, unter der das Intranet über den NetBird Reverse Proxy erreichbar ist
ORIGIN=https://intranet.example.de

# Version der Images aus GHCR (ghcr.io/extrempro/intranet). Fest eintragen und für
# ein Update ändern; „latest“ nimmt die neueste Version (nicht empfohlen im Betrieb).
INTRANET_VERSION=0.9.0

# Port auf dem Host, auf den der Reverse Proxy zeigt
APP_PORT=3000
# Adresse des Hosts, auf der der Port lauscht. Läuft der NetBird Reverse Proxy auf
# einem anderen Server, hier die NetBird-IP des Docker-Hosts eintragen, damit nur
# der Proxy die Anwendung erreicht (Standard: alle Adressen).
# APP_BIND=100.64.0.10

# Datenbank
POSTGRES_USER=intranet
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
POSTGRES_DB=intranet

# Passwort der eingeschränkten Rolle intranet_app, mit der die Anwendung Inhalte
# liest (Row-Level Security). Die Rolle legt eine Migration an, das Passwort setzt
# die Anwendung beim Start. Muss sich vom POSTGRES_PASSWORD unterscheiden.
APP_DATABASE_PASSWORD=bitte-ein-anderes-langes-zufaelliges-passwort

# Für lokale Entwicklung ohne Docker
DATABASE_URL=postgres://intranet:bitte-ein-langes-zufaelliges-passwort@localhost:5432/intranet

# Echte Client-Adresse hinter dem Reverse Proxy (NetBird). Ohne diese Angabe sieht
# die Anwendung nur die Adresse des Proxys: Begrenzungen je IP (Anmeldung,
# „Passwort vergessen“) gelten dann für alle gemeinsam, und das Protokoll zeigt
# überall dieselbe Adresse. Setzt der Proxy X-Forwarded-For, dann:
#   ADDRESS_HEADER=X-Forwarded-For
#   XFF_DEPTH=1   (Anzahl der Proxys vor der Anwendung)
# Prüfen unter Verwaltung → System („Erkannte Adresse“). Achtung: Fehlt der Header
# bei gesetztem ADDRESS_HEADER, antwortet die Anwendung mit einem Fehler.
# ADDRESS_HEADER=
# XFF_DEPTH=

# Maximale Größe einer Anfrage. Dateien werden einzeln hochgeladen (je höchstens 20 MB).
BODY_SIZE_LIMIT=21M

# Ablage für verschlüsselte Dateien (im Container /data/files, als Volume).
# Zusammen mit der Datenbank sichern: Ohne Datenbank (Schlüssel) sind die Dateien wertlos,
# ohne ENCRYPTION_KEY ebenso.
# FILES_DIR=./data/files

# Migrationen beim Start einspielen (Standard). Nur zur Fehlersuche abschalten.
# MIGRATE_ON_START=false

# --- Anmeldung mit Microsoft Entra ID ---
# App-Registrierung in Entra:
#   Umleitungs-URI (Web): ${ORIGIN}/anmelden/entra/callback
#   Delegierte Graph-Berechtigungen: openid, profile, email, User.Read,
#   GroupMember.Read.All (Administratorzustimmung erteilen)
#   Anwendungsberechtigungen (Administratorzustimmung erteilen):
#     User.Read.All, GroupMember.Read.All – nächtlicher Abgleich (Kap. 4.1)
# Tenant-ID, Client-ID und Zugangsgruppe werden später in der Verwaltung gepflegt;
# bis dahin gelten diese Werte. Das Secret bleibt immer hier (bzw. als Docker-Secret).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Object-ID der Gruppe, deren Mitglieder sich anmelden dürfen
ENTRA_ACCESS_GROUP_ID=
# Uhrzeit des täglichen Abgleichs (Europe/Berlin)
# ENTRA_SYNC_TIME=02:30

# --- E-Mail per SMTP (Einladungen, „Passwort vergessen“, Benachrichtigungen) ---
# Alles auch unter Verwaltung → Benachrichtigungen pflegbar; dort gespeicherte
# Werte gelten vor diesen. Ein dort eingegebenes Passwort wird mit ENCRYPTION_KEY
# verschlüsselt gespeichert.
SMTP_HOST=
# starttls (Standard, Port 587), tls (Port 465) oder none (interner Relay, Port 25)
SMTP_SECURITY=starttls
# SMTP_PORT=587
# Ohne Benutzer: Versand ohne Anmeldung (interner Relay)
SMTP_USER=
SMTP_PASSWORD=
# Absenderadresse und optional Anzeigename und Antwortadresse
MAIL_FROM=
# MAIL_FROM_NAME=Intranet
# MAIL_REPLY_TO=

# --- Verschlüsselung ---
# 32 Byte, base64. Erzeugen: openssl rand -base64 32
# Schützt u. a. die TOTP-Schlüssel. Nicht verlieren und nicht ändern, sonst
# müssen alle lokalen Konten den zweiten Faktor neu einrichten.
ENCRYPTION_KEY=

# --- Einrichtung ---
# Gibt es noch keinen System-Admin, schreibt die Anwendung beim Start einen
# Einrichtungslink ins Log (24 Stunden gültig): Hauptmandant und erster Admin
# als lokales Konto. Optional füllen diese Werte das Formular vor; sonst werden
# sie nicht gelesen. Domains durch Komma trennen.
# INITIAL_TENANT_NAME=
# INITIAL_TENANT_SHORT=
# INITIAL_TENANT_DOMAINS=
# INITIAL_TENANT_ACCENT=#0F6E56
# INITIAL_TENANT_ACCENT_DARK=#5DCAA5

# Kontaktadresse für Push-Dienste (VAPID „subject“). Die Schlüssel erzeugt die
# Anwendung beim ersten Start selbst und speichert sie verschlüsselt (ENCRYPTION_KEY).
# PUSH_CONTACT=mailto:it@staatsoper-hamburg.de

# --- Sicherung (Dienst backup, siehe backup/README.md) ---
# Öffentliche age-Schlüssel (age1…), mit Leerzeichen getrennt. Erzeugen auf einem
# Arbeitsplatz: age-keygen -o intranet-sicherung.key
# Den privaten Schlüssel nur im Passwortmanager ablegen, nie auf dem Server.
BACKUP_AGE_RECIPIENTS=
# Uhrzeit (Europe/Berlin), Aufbewahrung in Tagen, Wiederherstellungstest alle n Tage
# BACKUP_TIME=01:15
# BACKUP_KEEP_DAYS=30
# RESTORE_TEST_DAYS=7
