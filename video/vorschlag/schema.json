{
	"type": "object",
	"properties": {
		"zusammenfassung": { "type": "string", "maxLength": 1500 },
		"kapitel": {
			"type": "array",
			"maxItems": 20,
			"items": {
				"type": "object",
				"properties": {
					"start": { "type": "string", "pattern": "^([0-9]+:)?[0-9]{1,2}:[0-9]{2}$" },
					"titel": { "type": "string", "maxLength": 120 }
				},
				"required": ["start", "titel"],
				"additionalProperties": false
			}
		}
	},
	"required": ["zusammenfassung", "kapitel"],
	"additionalProperties": false
}
