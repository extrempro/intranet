{
	"ci": {
		"collect": {
			"url": [
				"http://localhost:3999/",
				"http://localhost:3999/hubs/chor",
				"http://localhost:3999/neuigkeiten"
			],
			"numberOfRuns": 1,
			"settings": {
				"chromeFlags": "--no-sandbox --headless=new",
				"extraHeaders": "{\"Cookie\": \"__Host-intranet-sitzung=e2e-nils\"}"
			}
		},
		"assert": {
			"assertions": {
				"categories:accessibility": ["error", { "minScore": 0.95 }],
				"categories:best-practices": ["error", { "minScore": 0.9 }],
				"categories:performance": ["warn", { "minScore": 0.8 }]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "./lighthouse"
		}
	}
}
